{
  "name": "candidate-portal",
  "version": "0.0.0",
  "license": "GPL-3.0-or-later",
  "scripts": {
    "ng": "ng",
    "start": "ng serve --host=127.0.0.1",
    "build": "ng build",
    "test": "ng test",
    "test:coverage": "ng test candidate-portal --watch=false --code-coverage=true --browsers=ChromeHeadless --source-map=true",
    "e2e": "playwright test",
    "e2e:auth": "playwright test --project=auth-setup",
    "e2e:verify-plus": "playwright test playwright-tests/verify-plus",
    "e2e:verify-plus:api": "playwright test --project=verify-plus-api",
    "e2e:verify-plus:decode:browser": "playwright test playwright-tests/verify-plus/verify-plus-decoding.spec.ts playwright-tests/verify-plus/verify-plus-high-density-decoding.spec.ts --project=chromium-desktop --project=firefox-desktop --project=webkit-desktop",
    "e2e:verify-plus:decode:mobile": "playwright test playwright-tests/verify-plus/verify-plus-decoding.spec.ts playwright-tests/verify-plus/verify-plus-high-density-decoding.spec.ts --project=android-pixel --project=ios-iphone --project=ios-ipad",
    "e2e:verify-plus:validation": "playwright test --project=verify-plus-validation",
    "e2e:install": "playwright install",
    "e2e:ui": "playwright test --ui",
    "e2e:headed": "playwright test --headed",
    "e2e:debug": "playwright test --debug",
    "e2e:report": "playwright show-report"
  },
  "private": true,
  "engines": {
    "node": "^22.22.3 || ^24.15.0 || >=26.0.0",
    "npm": ">=9.0.0"
  },
  "overrides": {
    "vite": "8.3.5"
  },
  "dependencies": {
    "@angular/animations": "^22.2.3",
    "@angular/common": "^22.2.3",
    "@angular/compiler": "^22.2.3",
    "@angular/core": "^22.2.3",
    "@angular/forms": "^22.2.3",
    "@angular/localize": "^22.2.3",
    "@angular/platform-browser": "^22.2.3",
    "@angular/platform-browser-dynamic": "^22.2.3",
    "@angular/router": "^22.2.3",
    "@ctrl/ngx-emoji-mart": "^6.2.0",
    "@fortawesome/fontawesome-free": "^6.2.0",
    "@microsoft/clarity": "^1.0.2",
    "@ng-bootstrap/ng-bootstrap": "^21.0.0",
    "@ng-select/ng-select": "~23.11.0",
    "@ngx-translate/core": "^15.0.0",
    "@ngx-translate/http-loader": "^6.0.0",
    "@popperjs/core": "^2.10.2",
    "@stomp/rx-stomp": "^1.1.4",
    "bootstrap": "^5.0.2",
    "core-js": "^3.25.3",
    "libphonenumber-js": "^1.12.8",
    "ngx-quill": "^16.2.1",
    "ngx-translate-phraseapp": "^0.4.2",
    "ngx-wig": "^22.0.0",
    "quill": "^1.3.7",
    "rxjs": "~7.8.2",
    "tslib": "^2.4.0",
    "zone.js": "^0.16.3",
    "zxing-wasm": "^3.1.2"
  },
  "devDependencies": {
    "@angular/build": "^22.2.3",
    "@angular/cli": "^22.2.3",
    "@angular/compiler-cli": "^22.2.3",
    "@angular/language-service": "^22.2.3",
    "@playwright/test": "^1.62.1",
    "@types/jasmine": "^5.1.4",
    "@types/node": "^24.0.0",
    "dotenv": "^17.4.2",
    "istanbul-lib-instrument": "^6.0.3",
    "jasmine-core": "~4.6.1",
    "karma": "^6.4.3",
    "karma-chrome-launcher": "^3.2.0",
    "karma-coverage": "^2.2.1",
    "karma-jasmine": "^5.1.0",
    "karma-jasmine-html-reporter": "^2.1.0",
    "postcss": "^8.4.16",
    "typescript": "~6.0.3"
  }
}
