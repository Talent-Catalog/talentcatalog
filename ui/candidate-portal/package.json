{
  "name": "candidate-portal",
  "version": "0.0.0",
  "license": "GPL-3.0-or-later",
  "scripts": {
    "ng": "ng",
    "start": "ng serve --host=127.0.0.1",
    "build": "ng build",
    "test": "ng test",
    "test:coverage": "ng test candidate-portal --watch=false --code-coverage=true --browsers=ChromeHeadless --source-map=true",
    "lint": "ng lint",
    "e2e": "playwright test",
    "e2e:auth": "playwright test --project=auth-setup",
    "e2e:verify-plus": "playwright test playwright-tests/verify-plus",
    "e2e:verify-plus:api": "playwright test --project=verify-plus-api",
    "e2e:verify-plus:decode": "playwright test playwright-tests/verify-plus/verify-plus-decoding.spec.ts playwright-tests/verify-plus/verify-plus-high-density-decoding.spec.ts --project=webkit-desktop --project=ios-iphone --project=android-pixel",
    "e2e:verify-plus:validation": "playwright test --project=verify-plus-validation",
    "e2e:install": "playwright install",
    "e2e:ui": "playwright test --ui",
    "e2e:headed": "playwright test --headed",
    "e2e:debug": "playwright test --debug",
    "e2e:report": "playwright show-report"
  },
  "private": true,
  "engines": {
    "node": ">=20.9.0",
    "npm": ">=9.0.0"
  },
  "dependencies": {
    "@angular/animations": "^17.3.12",
