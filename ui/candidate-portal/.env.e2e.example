# Candidate portal Playwright configuration.
# This is only for documentation purposes
# Copy this file to:
#   .env.e2e.local
#
# Replace placeholder values with values for your E2E environment.


# Candidate portal frontend URL.
E2E_BASE_URL=http://127.0.0.1:4200


# Candidate portal backend URL used by Playwright API tests.
E2E_API_BASE_URL=http://localhost:8080


# Dedicated GRN candidate used by Playwright.
E2E_CANDIDATE_USERNAME=replace-with-grn-candidate-username
E2E_CANDIDATE_PASSWORD=replace-with-grn-candidate-password


# Known unique UNHCR number belonging to the dedicated
# Playwright candidate. Verify+ API tests restore this
# value after tests that modify the candidate.
# baseline must be 123-45C67890
E2E_VERIFY_PLUS_BASELINE_UNHCR_ID=replace-with-baseline-unhcr-id


# Optional:
# UNHCR number belonging to another active-like candidate.
# duplicate browser test expects 999-00A11111
# Used to test Verify+ duplicate detection.
# Uncomment to enable the duplicate-detection test.
# E2E_VERIFY_PLUS_DUPLICATE_UNHCR_ID=replace-with-duplicate-unhcr-id
